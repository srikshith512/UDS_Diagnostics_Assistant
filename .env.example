# Copy to .env. Everything is optional; defaults are shown.

# Web port on the host
WEB_PORT=8080

# Language model (Ollama). Use any pulled model, e.g. llama3.2:3b or qwen2.5:7b.
LLM_ENABLED=true
LLM_MODEL=qwen2.5:3b
# Use http://host.docker.internal:11434 to reuse Ollama running on your machine.
OLLAMA_URL=http://ollama:11434
LLM_TIMEOUT=120

# Retrieval: "vector" (ChromaDB + embeddings) or "lexical" (no extra dependencies).
# Vector falls back to lexical automatically if it cannot start.
RETRIEVAL=vector
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Set to 0 to build a smaller backend image without chromadb and sentence-transformers.
INSTALL_RAG=1

MAX_UPLOAD_BYTES=1000000
